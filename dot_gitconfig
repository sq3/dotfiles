[user]
	name = Marc Schnitzius
	email = marc.schnitzius@codecentric.de
	signingkey = ssh-rsa 
[core]
	excludesFile = ~/.gitignore
	autocrlf = input
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[init]
	defaultBranch = main
